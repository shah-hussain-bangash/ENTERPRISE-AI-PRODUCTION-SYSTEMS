# Copy to .env.local in THIS dashboard folder. Never copy another project's secrets.
# Restart the dashboard after changing these values.
WORKSPACE_ACCESS_MODE=local
# For a future authenticated reverse proxy only; see docs/DEPLOYMENT.md.
WORKSPACE_GATEWAY_SECRET=
CONNECTION_TIMEOUT_MS=3000

# Nawa native defaults. If --auto-ports chooses different ports, update both URLs.
NAWA_ENABLED=true
NAWA_WEB_URL=http://127.0.0.1:5173
NAWA_API_URL=http://127.0.0.1:8000
NAWA_HEALTH_PATH=/health/ready
NAWA_HEALTH_KEY=status
NAWA_HEALTH_VALUE=ready

# SupplyPilot serves UI and API together on the verified local port 8002.
SUPPLYPILOT_ENABLED=true
SUPPLYPILOT_WEB_URL=http://127.0.0.1:8002
SUPPLYPILOT_API_URL=http://127.0.0.1:8002
SUPPLYPILOT_HEALTH_PATH=/health
SUPPLYPILOT_HEALTH_KEY=status
SUPPLYPILOT_HEALTH_VALUE=ok

# FinAgent local health contract verified during setup.
FINAGENT_ENABLED=true
FINAGENT_WEB_URL=http://127.0.0.1:3001
FINAGENT_API_URL=http://127.0.0.1:8001
FINAGENT_HEALTH_PATH=/health/live
FINAGENT_HEALTH_KEY=status
FINAGENT_HEALTH_VALUE=ok
