{
  "name": "zenith-enterprise-ai-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/integration-service.test.mjs",
    "check": "npm run typecheck && npm test",
    "connections:check": "node scripts/check-connections.mjs",
    "test:http": "node tests/production-smoke.mjs"
  },
  "dependencies": {
    "@next/env": "16.4.6",
    "jose": "^6.2.17",
    "lucide-react": "1.31.0",
    "next": "16.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
